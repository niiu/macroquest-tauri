{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macroquest",
  "version": "0.2.26",
  "identifier": "ru.macroquest.editor",
  "build": {
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Макроквест · Мастерская историй",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
